<?xml version="1.0" encoding="utf-8"?>
<materialdescriptor xmlns:xi="#" name="WD2FxAlpha" displayname="WD2FxAlpha" showinui="1" category="Particle" id="#(0x2e0abff2, 0x30a5a9dc)">
    <geometryInputs normal="1" tangent="1" binormal="1" color="1" uvChannels="8" />

    <parameter name="DiffuseTexture1" type="sampler2D" tilingName="DiffuseTiling1" UvName="DiffuseUV1" uvTilingName="DiffuseUVTiling1" maxdisplayname="Base texture" optional="0" />
    <parameter name="DiffuseTexture1State" type="samplerState" defaultvalue="ColorClamp" />
    <parameter name="DiffuseTiling1" type="float2" defaultvalue="1,1" />
    <parameter name="DiffuseUV1" type="int" />
    <parameter name="DiffuseUVTiling1" type="float4" provideronly="1" />

    <parameter name="EmissiveMaskTexture" type="sampler2D" tilingName="DiffuseTiling1" UvName="DiffuseUV1" uvTilingName="DiffuseUVTiling1" maxdisplayname="Emissive mask" optional="1" />
    <parameter name="EmissiveMaskColor" type="color4" defaultvalue="1,1,1,1" />

    <parameter name="AlphaTestEnabled" type="bool" defaultvalue="1" />
    <parameter name="AlphaTestValue" type="float" defaultvalue="128" div="255"/>
    <parameter name="AlphaBlendEnabled" type="bool" defaultvalue="0" />
  
    <parameter name="Soft" type="bool" defaultvalue="0" />
    <parameter name="SoftDistance" type="float" defaultvalue="0.0" op_x="1/x" />

    <parameter name="LightingType" type="int" defaultvalue="2" />
    <parameter name="Sun" type="bool" defaultvalue="1" />

    <parameter name="Transparency" type="float" defaultvalue="0.0" />

    <parameter name="FadeAngle" type="float" defaultvalue="1.57" />
  
    <parameter name="AnimationTiling" type="float2" defaultvalue="1,1" op_x="1/x" op_y="1/y" />
    <parameter name="AnimationFramerate" type="float" defaultvalue="1" reloadMaterial="1" />
    <parameter name="AnimationBlend" type="bool" defaultvalue="0" oldnames="BlendFrames" />
    <parameter name="AnimationFit" type="bool" defaultvalue="0" reloadMaterial="1" />
    
    <parameter name="Disable_Z" type="bool" defaultvalue="0" />

    <parameter name="ResponsiveAAStrength" type="float" defaultvalue="2.0"/>

    <parameter name="MSAAOptimizationHighQuality" type="bool" defaultvalue="1" />

    <!-- Shader parameters -->
    <parameterprovider parametersfilename="Particle_WD2FxAlpha.fx">
        <parameter name="DiffuseTexture1" />
        <parameter name="DiffuseTexture1State" />
        <parameter name="DiffuseUVTiling1" />
        <parameter name="EmissiveMaskTexture" />
        <parameter name="EmissiveMaskColor" />
        <parameter name="AlphaTestEnabled" />
        <parameter name="AlphaTestValue" />
        <parameter name="AlphaBlendEnabled" />
        <parameter name="Soft" />
        <parameter name="SoftDistance" />
        <parameter name="LightingType" />
        <parameter name="Sun" />
        <parameter name="Transparency"/>
        <parameter name="FadeAngle"/>
        <parameter name="AnimationTiling" />
        <parameter name="AnimationFramerate" />
        <parameter name="AnimationBlend" />
        <parameter name="AnimationFit" />
        <parameter name="Disable_Z" />
        <parameter name="ResponsiveAAStrength" />
        <parameter name="MSAAOptimizationHighQuality" />
    </parameterprovider>

    <!-- Conditional Shader Options -->
    <shaderoptions>
        <shaderoption name="ALPHA_TEST">
            <condition parameter="AlphaTestEnabled" />
        </shaderoption>
        <shaderoption name="SOFT">
            <condition parameter="AlphaBlendEnabled" />
            <condition parameter="Soft" />
        </shaderoption>
        <shaderoption name="LIGHTING_TYPE" parameter="LightingType">
            <condition parameter="LightingType" op="greaterequal" value="0"/>
        </shaderoption>
        <shaderoption name="SUN">
            <condition parameter="LightingType" op="greater" value="0" />
            <condition parameter="Sun" />
        </shaderoption>
        <shaderoption name="TEXANIM_LERP">
            <condition parameter="AnimationBlend" />
        </shaderoption>
        <shaderoption name="EMISSIVE_MASK">
            <condition parameter="EmissiveMaskTexture" />
        </shaderoption>
        <shaderoption name="DISABLE_Z">
            <condition parameter="Disable_Z" />
        </shaderoption>
        <shaderoption name="MSAA_TRANSPARENCIES_HIGH">
            <condition parameter="MSAAOptimizationHighQuality" />
        </shaderoption>
    </shaderoptions>
  
    <!-- Material UI definition -->
    <ui defaultFilePath="graphics/_Texture/" >
        <xi:include href="UI/DataClasses.xml" />
        <group label="Base settings">
            <!-- Responsive AA -->
            <label alignright="1" width="120">Responsive AA Strength</label>
            <textbox dataBindings="ResponsiveAAStrength">
                <databindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
            </textbox>
            <!-- MSAA Optimization -->
            <checkbox label="Use MSAA high quality optimization" dataBindings="MSAAOptimizationHighQuality" tooltip="Parameter to control MSAA optimization quality. If unchecked shader evaluated once for a group of 2x2 pixels." />
        </group>
        <group label="Texture" horizontal="1">
            <button dataBindings="DiffuseTexture1" fill="1" />
            <combobox dataBindings="DiffuseTexture1State">
              <comboboxitem value="ColorClamp">Clamp</comboboxitem>
              <comboboxitem value="ColorClampAniso">Clamp Aniso (Expensive)</comboboxitem>
            </combobox>
        </group>
        <group label="Emissive Mask" horizontal="1">
            <label>Color:</label>
            <button dataBindings="EmissiveMaskColor" />
            <label>Mask:</label>
            <button dataBindings="EmissiveMaskTexture" fill="1" />
            <label/>
        </group>
        <group label="Lighting" horizontal="0">
            <group horizontal="1">
                <label>Lighting Type:</label>
                <combobox dataBindings="LightingType">
                    <comboboxitem value="0">Unlit</comboboxitem>
                    <comboboxitem value="1">Emitter</comboboxitem>
                    <comboboxitem value="2">Particle Center</comboboxitem>
                    <comboboxitem value="3">Vertex</comboboxitem>                    
                    <comboboxitem value="4">Pixel</comboboxitem>
                </combobox>
            </group>
            <group horizontal="1">
                <group horizontal="1">
                    <checkbox label="Affected by sun" dataBindings="Sun" />
                </group>
            </group>
        </group>
        <xi:include href="UI/ParticleAnimationGroup.xml" />
        <group horizontal="1">
            <checkbox label="Alpha test" dataBindings="AlphaTestEnabled" />
            <group horizontal="1" show_if="AlphaTestEnabled">
                <slider dataBindings="AlphaTestValue">
                    <dataBindings increment="1" minvalue="0" maxvalue="255"/>
                </slider>
            </group>
        </group>
        <group>
            <checkbox label="Alpha blend" dataBindings="AlphaBlendEnabled" />
        </group>
        <group show_if="AlphaBlendEnabled">
            <group label="Soft" horizontal="1">
                <checkbox label="Enable" dataBindings="Soft" />
                <group horizontal="1" show_if="Soft">
                    <label>Distance: </label>
                    <textbox databindings="SoftDistance">
                        <databindings increment="0.01" minvalue="0" maxvalue="100.0" />
                    </textbox>
                </group>
            </group>            
            <group horizontal="1">
                <label width="80">Transparency:</label>
                <label width="50" alignright="1">Fade</label>
                <slider dataBindings="Transparency">
                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                </slider>
                <label width="50">Dissolve</label>
            </group>
        </group>
        <group>
            <checkbox label="See Through Walls" dataBindings="Disable_Z" />
        </group>
        <group horizontal="1">
            <label>Fade Angle: </label>
            <textbox databindings="FadeAngle">
                <databindings increment="0.01" minvalue="0" maxvalue="1.57" />
            </textbox>
        </group>
        <group label="Custom data over particle lifetime">
            <label color="BB0000">X: (unused)</label>
            <label color="00BB00">Y: Emissive mask scale over particle lifetime</label>
            <label color="0000AA">Z: (unused)</label>
            <label color="404040">W: (unused)</label>
        </group>
        <group label="Custom data over emitter lifetime">
            <label color="BB0000">X: (unused)</label>
            <label color="00BB00">Y: (unused)</label>
            <label color="0000AA">Z: (unused)</label>
            <label color="404040">W: (unused)</label>
        </group>
    </ui>
</materialdescriptor>