<?xml version="1.0" encoding="utf-8"?>
<materialdescriptor xmlns:xi="#" name="WD3Glass" showinui="1" id="#(0x2240e84, 0x71951684)">
    <geometryInputs normal="1" tangent="1" binormal="1" color="1" uvChannels="2" packedUVChannel="10" bonecount="1" reduceMatrixPerDrawCallBy="14" />

    <parameter name="CastShadow" type="bool" defaultvalue="1" />
    <parameter name="TwoSided" type="bool" />
    <parameter name="SortingLayerBias" type="int" defaultvalue="0"/>
    <parameter name="WetSurfaceTypeIndex" type="int" defaultvalue="0" />


    <!-- Opacity Falloff -->
    <parameter name="EnableOpacityFalloff" type="bool" defaultvalue="0" />
	<parameter name="FalloffStart" type="float" defaultvalue="32" />
    <parameter name="FalloffEnd" type="float" defaultvalue="63" />    

    <!-- Base color -->
    <parameter name="BaseColor" type="color3" defaultvalue="1,1,1" />
    <parameter name="BaseColorTexture" type="sampler2D" tilingName="BaseColorTiling" UvName="BaseColorUV" uvTilingName="BaseColorUVTiling" maxdisplayname="Base Color Texture" optional="1" />
    <parameter name="BaseColorTiling" type="float2" defaultvalue="1,1" />
    <parameter name="BaseColorUV" type="int" />
    <parameter name="BaseColorUVTiling" type="float4" provideronly="1" />
    <parameter name="BaseColorTextureState" type="samplerState" defaultvalue="ColorWrap" />
    <parameter name="EnableSurfaceMask" type="bool" defaultvalue="0" />
    
    <parameter name="EnableThickness" type="bool" defaultvalue="0" />
    <parameter name="ModulateRefThicknessByVertexAlpha" type="bool" defaultvalue="0" />
    <parameter name="Thickness" type="float" defaultvalue="1" />

    <!-- BRDF -->
    <parameter name="SurfaceParametersTexture" type="sampler2D" tilingName="SurfaceParametersTiling" UvName="SurfaceParametersUV" uvTilingName="SurfaceParametersUVTiling" maxdisplayname="Surface Parameters Texture" optional="1" />
    <parameter name="SurfaceParametersTextureState" type="samplerState" defaultvalue="ColorWrap" />
    <parameter name="SurfaceParametersTiling" type="float2" defaultvalue="1,1" />
    <parameter name="SurfaceParametersUV" type="int" />
    <parameter name="SurfaceParametersUVTiling" type="float4" provideronly="1" />
    <parameter name="OverrideRoughness" type="bool" defaultvalue="0" />
    <parameter name="OverrideRoughnessValue" type="float" defaultvalue="0.0" />
    <parameter name="OverrideMetalness" type="bool" defaultvalue="0" />
    <parameter name="OverrideMetalnessValue" type="float" defaultvalue="0.0" />
    <parameter name="NormalIntensity" type="float" defaultvalue="1" />

    <!-- Dust -->
    <parameter name="Dust" type="bool" defaultvalue="0" />
    <parameter name="DustMaskTexture" type="sampler2D" tilingName="DustMaskTextureTiling" UvName="DustMaskTextureUV" uvTilingName="DustMaskTextureUVTiling" maxdisplayname="Dust Mask Texture" optional="1" engine_only="1"/>
    <parameter name="DustMaskTextureState" type="samplerState" defaultvalue="ColorWrap" />
    <parameter name="DustMaskTextureTiling" type="float2" defaultvalue="1,1" />
    <parameter name="DustMaskTextureUV" type="int" />
    <parameter name="DustMaskTextureUVTiling" type="float4" provideronly="1" />
    <parameter name="DustMaskChannel" type="float4" defaultvalue="0,0,0,1" />
    <parameter name="DustAlbedoStrength" type="float" defaultvalue="1" />
    <parameter name="DustRoughnessStrength" type="float" defaultvalue="1" />
    <parameter name="DustTranslucency" type="float" defaultvalue="1" />
    <parameter name="DustAlbedo" type="color3" defaultvalue="1,1,1" />
    <parameter name="DustRoughness" type="float" defaultvalue="0" />

    <!-- Refraction -->
    <parameter name="Refraction" type="bool" defaultvalue="0"/>
    <parameter name="RefractionContactHardening" type="bool" defaultvalue="1" />
    <parameter name="RefractionDistortion" type="bool" defaultvalue="0"/>
    <parameter name="RefractionDistortionThickness" type="float" defaultvalue="1"/>
    <parameter name="RefractionBlurrinessScale" type="float" defaultvalue="1.0" />
    <parameter name="RefractionMinRoughness" type="float" defaultvalue="0.02" />

    <!-- Responsive AA -->
    <parameter name="UseResponsiveAA" type="bool" defaultvalue="0" />
    <parameter name="ResponsiveAAStrength" type="float" defaultvalue="1.0" />

    <!-- Emissive-->
    <parameter name="EmissiveMode" type="int" defaultvalue="0" />
    <parameter name="EmissiveColor" type="color3" defaultvalue="1,1,1" />
    <parameter name="VideoTexture1" type="bink" tilingName="EmissiveTiling" UvName="EmissiveUV" uvTilingName="EmissiveUVTiling" optional="1" />
    <parameter name="EmissiveTexture" type="sampler2D" tilingName="EmissiveTiling" UvName="EmissiveUV" uvTilingName="EmissiveUVTiling" maxdisplayname="Emissive Texture" optional="1" />
    <parameter name="EmissiveTiling" type="float2" defaultvalue="1,1" />
    <parameter name="EmissiveUV" type="int" />
    <parameter name="EmissiveUVTiling" type="float4" provideronly="1" />
    <parameter name="EmissiveUVOffset" type="float2" defaultvalue="0,0" />
    <parameter name="EmissiveTextureState" type="samplerState" defaultvalue="ColorWrap" />
    <parameter name="EmissiveTextureRemap" type="float3" defaultvalue="1,0,1" />
    <parameter name="PreMultiplyEmissiveByAlpha" type="bool" defaultvalue="0" />
    <parameter name="EmissiveIntensity" type="float" defaultvalue="9" op_x="ev100" />
    <parameter name="EmissiveIntensityOffset" type="float" defaultvalue="-99" op_x="ev100" />
    <parameter name="VideoPlayOnLoad"   type="bool" defaultvalue="1"/>
    <parameter name="VideoShareChannel" type="int" defaultvalue="0"/>

    <!-- Texture animation -->
    <parameter name="AnimType" type="int" />
    <parameter name="EmissiveUVSpeed" type="float2" />
    <parameter name="NbFramesX" type="int" />
    <parameter name="NbFramesY" type="int" />
    <parameter name="Framerate" type="float" />
    <parameter name="RandomAnimationTime" type="bool" />
    <parameter name="BlendFrames" type="bool">
        <use_if parameter="AnimType" value="2" />
    </parameter>
    <parameter name="BlendDelay" type="float" />

    <!-- MSAA Optimization -->
    <parameter name="MSAAOptimizationHighQuality" type="bool" defaultvalue="1" />

    <parameterprovider parametersfilename="Mesh_WD3Glass.fx">
        <parameter name="WetSurfaceTypeIndex" />

		<parameter name="EnableOpacityFalloff" />
        <parameter name="FalloffStart" />
	    <parameter name="FalloffEnd" />
                
        <parameter name="BaseColor" />
        <parameter name="BaseColorTexture" />
        <parameter name="BaseColorTextureState" />
        <parameter name="BaseColorUVTiling" />
        <parameter name="EnableSurfaceMask" />
        <parameter name="EnableThickness" />
        <parameter name="ModulateRefThicknessByVertexAlpha" />
        <parameter name="Thickness" />

        <parameter name="SurfaceParametersTexture" />
        <parameter name="SurfaceParametersTextureState" />
        <parameter name="SurfaceParametersUVTiling" />
        <parameter name="NormalIntensity" />
        <parameter name="OverrideRoughness" />
        <parameter name="OverrideRoughnessValue" />
        <parameter name="OverrideMetalness" />
        <parameter name="OverrideMetalnessValue" />

        <parameter name="Dust" />
        <parameter name="DustMaskTexture" />
        <parameter name="DustMaskTextureState" />
        <parameter name="DustMaskTextureUVTiling" />
        <parameter name="DustMaskChannel" />
        <parameter name="DustAlbedoStrength" />
        <parameter name="DustRoughnessStrength" />        
        <parameter name="DustTranslucency" />
        <parameter name="DustAlbedo" />
        <parameter name="DustRoughness" />

        <parameter name="Refraction" />
        <parameter name="RefractionContactHardening" />
        <parameter name="RefractionDistortion" />
        <parameter name="RefractionDistortionThickness" />
        <parameter name="RefractionBlurrinessScale" />
        <parameter name="RefractionMinRoughness" />

        <!-- Responsive AA -->
        <parameter name="UseResponsiveAA" />
        <parameter name="ResponsiveAAStrength" />

        <parameter name="EmissiveMode" />
        <parameter name="EmissiveColor" />
        <parameter name="EmissiveTexture" />
        <parameter name="VideoTexture1" />
        <parameter name="EmissiveTextureState" />
        <parameter name="EmissiveUV" />
        <parameter name="EmissiveTiling" />
        <parameter name="EmissiveUVTiling" />
        <parameter name="EmissiveUVOffset" />
        <parameter name="EmissiveTextureRemap" />
        <parameter name="PreMultiplyEmissiveByAlpha" />
        <parameter name="EmissiveIntensity" />
        <parameter name="EmissiveIntensityOffset" />

    <parameter name="AnimType" />
        <parameter name="EmissiveUVSpeed" />
        <parameter name="NbFramesX" />
        <parameter name="NbFramesY" />
        <parameter name="BlendFrames" />
        <parameter name="Framerate" />
        <parameter name="RandomAnimationTime" />
        <parameter name="BlendDelay" />
        <parameter name="MSAAOptimizationHighQuality" />
    </parameterprovider>

    <shaderoptions>
        <shaderoption name="USE_BASE_COLOR_TEXTURE">
            <condition parameter="BaseColorTexture" />
        </shaderoption>
        <shaderoption name="USE_SURFACE_PARAMETERS_TEXTURE">
            <condition parameter="SurfaceParametersTexture" />
        </shaderoption>
        <shaderoption name="DUST_LAYER">
            <condition parameter="Dust" op="equal" value="1" />
            <condition parameter="DustMaskTexture" />
        </shaderoption>
        <shaderoption name="USE_EMISSIVE_TEXTURE">
            <condition parameter="EmissiveTexture" />
            <condition parameter="EmissiveMode" op="equal" value="1"  />
        </shaderoption>
        <shaderoption name="USE_EMISSIVE_VIDEO_TEXTURE">
            <condition parameter="VideoTexture1" />
            <condition parameter="EmissiveMode" op="equal" value="2"  />
        </shaderoption>
        <shaderoption name="REFRACTION">
            <condition parameter="Refraction" op="equal" value="1" />
        </shaderoption>        
        <shaderoption name="REFRACTION_DISTORTION">
            <condition parameter="Refraction" op="equal" value="1" />
            <condition parameter="RefractionDistortion" op="equal" value="1" />
        </shaderoption>
        <shaderoption name="REFRACTION_CONTACT_HARDENING">
            <condition parameter="Refraction" op="equal" value="1" />
            <condition parameter="RefractionContactHardening" op="equal" value="1" />
        </shaderoption>
        <shaderoption name="RESPONSIVE_AA">
            <condition parameter="UseResponsiveAA" />
        </shaderoption>
        <shaderoption name="MSAA_TRANSPARENCIES_HIGH">
            <condition parameter="MSAAOptimizationHighQuality" />
        </shaderoption>
    </shaderoptions>

    <ui defaultFilePath="graphics/_Textures/" >
        <xi:include href="UI/DataClasses.xml" />
        <group label="Settings">
            <checkbox label="Two sided" dataBindings="TwoSided" />
            <checkbox label="Cast Shadow" dataBindings="CastShadow" />
            <checkbox label="Dust" dataBindings="Dust" />
            <checkbox label="Opacity Falloff" dataBindings="EnableOpacityFalloff" />
            <checkbox label="Refraction" dataBindings="Refraction" />
            <!-- Responsive AA -->
            <checkbox label="Enable ResponsiveAA" dataBindings="UseResponsiveAA" tooltip="Parameter to make TAA pass through the glass material avoiding smudging." />
            <!-- MSAA Optimization -->
            <checkbox label="Use MSAA high quality optimization" dataBindings="MSAAOptimizationHighQuality" tooltip="Parameter to control MSAA optimization quality. If unchecked shader evaluated once for a group of 2x2 pixels." />
            <group horizontal="1">
                <label>Sorting Layer Bias</label>
                <textbox dataBindings="SortingLayerBias" tooltip="Changes the draw order.  Materials with smaller values are drawn first.">
                    <dataBindings increment="1" minvalue="-4" maxvalue="4" />
                </textbox>
            </group>
            <group horizontal="1">
                <label>Wet Surface Type: </label>
                <combobox dataBindings="WetSurfaceTypeIndex">
                    <comboboxitem value="0">Default</comboboxitem>
                    <comboboxitem value="-1">Never Wet</comboboxitem>
                    <comboboxitem value="1">Car Window</comboboxitem>
                </combobox>
            </group>
            <group horizontal="1">
                <label>Emissive Mode: </label>
                <combobox dataBindings="EmissiveMode">
                    <comboboxitem value="0">None</comboboxitem>
                    <comboboxitem value="1">Texture</comboboxitem>
                    <comboboxitem value="2">Video</comboboxitem>
                </combobox>
            </group>
        </group>

        <label> </label>
        <group label="Opacity Falloff" show_if="EnableOpacityFalloff==1">
            <group horizontal="1">
                <label width="140">Falloff Start: </label>
                <textbox dataBindings="FalloffStart">
                    <databindings increment="0.1" minvalue="0.0" maxvalue="127.0" />
                </textbox>
                <slider databindings="FalloffStart">
                    <databindings increment="0.1" minvalue="0.0" maxvalue="127.0" />
                </slider>
            </group>
            <group horizontal="1">
                <label width="140">Falloff End: </label>
                <textbox dataBindings="FalloffEnd">
                    <databindings increment="0.1" minvalue="63.0" maxvalue="383.0" />
                </textbox>
                <slider dataBindings="FalloffEnd">
                    <dataBindings increment="0.1" minvalue="63.0" maxvalue="383.0" />
                </slider>
            </group>
        </group>

        <label> </label>
        <group label="Base Color">
            <group horizontal="1">
                <button dataBindings="BaseColor" />
                <button dataBindings="BaseColorTexture" />
                <textbox dataBindings="BaseColorUV">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <textbox dataBindings="BaseColorTiling.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="BaseColorTiling.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
                <combobox dataBindings="BaseColorTextureState">
                    <comboboxitem value="ColorWrap">Wrap</comboboxitem>
                    <comboboxitem value="ColorClamp">Clamp</comboboxitem>
                    <comboboxitem value="ColorMirror">Mirror</comboboxitem>
                    <comboboxitem value="ColorWrapAniso">Wrap Aniso (Expensive)</comboboxitem>
                    <comboboxitem value="ColorWrapHClampV">Wrap H - Clamp V</comboboxitem>
                </combobox>
            </group>
            <checkbox label="Enable Surface Mask (Alpha Channel)" dataBindings="EnableSurfaceMask" />
            <checkbox label="Modulate reference thickness by vertex alpha" dataBindings="ModulateRefThicknessByVertexAlpha" />
            <checkbox label="Enable Thickness (Reference Thickness = 1cm)" dataBindings="EnableThickness" />
            <group show_if="EnableThickness">
                <group horizontal="1">
                    <label>Thickness (cm)</label>
                    <textbox dataBindings="Thickness" minvalue="0.0" maxvalue="65536.0" />
                </group>
            </group>
        </group>

        <label> </label>
        <group horizontal="0" label="BRDF" show_if="SubFamily==0">
            <group horizontal="1">
                <button dataBindings="SurfaceParametersTexture" fill="1" />
                <textbox dataBindings="SurfaceParametersUV">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <textbox dataBindings="SurfaceParametersTiling.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="SurfaceParametersTiling.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
                <combobox dataBindings="SurfaceParametersTextureState">
                    <comboboxitem value="ColorWrap">Wrap</comboboxitem>
                    <comboboxitem value="ColorClamp">Clamp</comboboxitem>
                    <comboboxitem value="ColorMirror">Mirror</comboboxitem>
                    <comboboxitem value="ColorWrapAniso">Wrap Aniso (Expensive)</comboboxitem>
                </combobox>
            </group>
            <group horizontal="1">
                <label width="210">Normal Strength: </label>
                <textbox databindings="NormalIntensity">
                    <databindings increment="0.01" minvalue="0" maxvalue="2.0" />
                </textbox>
                <label> 0</label>
                <slider dataBindings="NormalIntensity">
                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="2.0" />
                </slider>
                <label>2</label>
            </group>

            <group horizontal="1">
                <checkbox label="Override Roughness (Blue): " dataBindings="OverrideRoughness" width="210"/>
                <textbox databindings="OverrideRoughnessValue">
                    <databindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                </textbox>
                <label> 0</label>
                <slider dataBindings="OverrideRoughnessValue">
                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                </slider>
                <label>1</label>
            </group>

            <group horizontal="1">
                <checkbox label="Override Metalness (Alpha): " dataBindings="OverrideMetalness" width="210"/>
                <textbox databindings="OverrideMetalnessValue">
                    <databindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                </textbox>
                <label> 0</label>
                <slider dataBindings="OverrideMetalnessValue">
                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                </slider>
                <label>1</label>
            </group>
        </group>

        <label> </label>
        <group horizontal="0" label="Dust" show_if="Dust==1">
            <group horizontal="0">
                <group horizontal="1">
                    <button dataBindings="DustMaskTexture" fill="1" />
                    <textbox dataBindings="DustMaskTextureUV">
                        <dataBindings class="UVChannel" />
                    </textbox>
                    <group>
                        <textbox dataBindings="DustMaskTextureTiling.x">
                            <dataBindings class="Tiling" />
                        </textbox>
                        <textbox dataBindings="DustMaskTextureTiling.y">
                            <dataBindings class="Tiling" />
                        </textbox>
                    </group>
                    <combobox dataBindings="DustMaskTextureState">
                        <comboboxitem value="ColorWrap">Wrap</comboboxitem>
                        <comboboxitem value="ColorClamp">Clamp</comboboxitem>
                        <comboboxitem value="ColorMirror">Mirror</comboboxitem>
                        <comboboxitem value="ColorWrapAniso">Wrap Aniso (Expensive)</comboboxitem>
                    </combobox>
                </group>

                <group horizontal="0">
                    <group horizontal="1">
                        <label>Channel:</label>
                        <combobox dataBindings="DustMaskChannel">
                            <comboboxitem value="1,0,0,0">Red</comboboxitem>
                            <comboboxitem value="0,1,0,0">Green</comboboxitem>
                            <comboboxitem value="0,0,1,0">Blue</comboboxitem>
                            <comboboxitem value="0,0,0,1">Alpha</comboboxitem>
                        </combobox>
                    </group>
                    <group>
                        <group horizontal="1">
                            <label width="120">Albedo:</label>
                            <button dataBindings="DustAlbedo"/>
                        </group>
                        <group horizontal="1">
                            <label width="120">Albedo Strength:</label>
                            <textbox dataBindings="DustAlbedoStrength">
                                <databindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                            </textbox>
                            <slider dataBindings="DustAlbedoStrength">
                                <dataBindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                            </slider>
                        </group>
                    </group>
                    <group>
                        <group horizontal="1">
                            <label width="120">Roughness:</label>
                            <group horizontal="1">
                                <textbox databindings="DustRoughness">
                                    <databindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                                </textbox>
                                <slider dataBindings="DustRoughness">
                                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                                </slider>
                            </group>
                        </group>
                        <group horizontal="1">
                            <label width="120">Roughness Strength:</label>
                            <textbox dataBindings="DustRoughnessStrength">
                                <databindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                            </textbox>
                            <slider dataBindings="DustRoughnessStrength">
                                <dataBindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                            </slider>
                        </group>
                    </group>
                    <group horizontal="1">
                        <label width="120">Translucency:</label>
                        <textbox dataBindings="DustTranslucency">
                            <databindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                        </textbox>
                        <slider dataBindings="DustTranslucency">
                            <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                        </slider>
                    </group>
                </group>
            </group>
        </group>

        <label> </label>
        <group horizontal="0" label="Refraction" show_if="Refraction==1">
            <group horizontal="0">
                <group horizontal="1">
                    <label width="140">Blurriness Scale:</label>
                    <textbox dataBindings="RefractionBlurrinessScale">
                        <databindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                    </textbox>
                    <slider dataBindings="RefractionBlurrinessScale">
                        <dataBindings increment="0.01" minvalue="0.0" maxvalue="1.0" />
                    </slider>
                </group>
                
                <group horizontal="1">
                    <label width="140">Min Roughness:</label>
                    <textbox dataBindings="RefractionMinRoughness">
                        <databindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </textbox>
                    <slider dataBindings="RefractionMinRoughness">
                        <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </slider>
                </group>

                <checkbox label="Contact Hardening" dataBindings="RefractionContactHardening" />
                
                <checkbox label="Distortion" dataBindings="RefractionDistortion" />                
                <group horizontal="1" show_if="RefractionDistortion==1">
                    <label width="140">Distortion Thickness (cm)</label>
                    <textbox dataBindings="RefractionDistortionThickness" minvalue="0.0" maxvalue="65536.0" />
                </group>
            </group>
        </group>

        <label> </label>
        <group horizontal="0" label="ResponsiveAA" show_if="UseResponsiveAA==1">
            <group horizontal="0">
                <label width="140">Responsive AA Strength:</label>
                <textbox dataBindings="ResponsiveAAStrength">
                    <databindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                </textbox>
                <slider dataBindings="ResponsiveAAStrength">
                    <dataBindings increment="0.01" minvalue="0.0" maxvalue="10.0" />
                </slider>
            </group>
        </group>
        
        <label> </label>
        <group label="Emissive" show_if="EmissiveMode!=0">
            <group horizontal="1">
                <button dataBindings="EmissiveColor" />
                <group show_if="EmissiveMode==1" >
                    <button dataBindings="EmissiveTexture"/>
                </group>
                <group show_if="EmissiveMode==2" >
                    <button dataBindings="VideoTexture1"/>
                </group>
                <textbox dataBindings="EmissiveUV">
                    <dataBindings class="UVChannel" />
                </textbox>
                <group>
                    <label>Tiling</label>
                    <textbox dataBindings="EmissiveTiling.x">
                        <dataBindings class="Tiling" />
                    </textbox>
                    <textbox dataBindings="EmissiveTiling.y">
                        <dataBindings class="Tiling" />
                    </textbox>
                </group>
                <group>
                    <label>Offset</label>
                    <textbox dataBindings="EmissiveUVOffset.x" />
                    <textbox dataBindings="EmissiveUVOffset.y" />
                </group>
                <group show_if="EmissiveMode==1">
                    <combobox dataBindings="EmissiveTextureState">
                        <comboboxitem value="ColorWrap">Wrap</comboboxitem>
                        <comboboxitem value="ColorClamp">Clamp</comboboxitem>
                        <comboboxitem value="ColorMirror">Mirror</comboboxitem>
                        <comboboxitem value="ColorWrapAniso">Wrap Aniso (Expensive)</comboboxitem>
                        <comboboxitem value="ColorWrapHClampV">Wrap H - Clamp V</comboboxitem>
                    </combobox>
                </group>
            </group>

            <!-- Texture Animation -->
            <group show_if="EmissiveMode==1">
                <label>Animation type</label>
                <group horizontal="1">
                    <combobox dataBindings="AnimType">
                        <comboboxitem value="0">None</comboboxitem>
                        <comboboxitem value="1">UV Scrolling</comboboxitem>
                        <comboboxitem value="2">Flipbook animation</comboboxitem>
                        <comboboxitem value="5">Flipbook animation (ping pong)</comboboxitem>
                        <comboboxitem value="6">Flipbook animation (code controled)</comboboxitem>
                        <comboboxitem value="3">UV PingPong Scrolling</comboboxitem>
                        <comboboxitem value="4">Rotozoom</comboboxitem>
                    </combobox>
                    <group show_if="AnimType==2">
                        <label>Flipbook initial frame set by code for entities (default 0)</label>
                    </group>
                    <group show_if="AnimType==5">
                        <label>Only horizontal flipbooks are supported in ping-pong mode.</label>
                    </group>
                    <group show_if="AnimType==6">
                        <label>The flipbook animation is controled exclusivly by code. Initial frame is 0 by default.</label>
                    </group>
                </group>

                <group show_if="AnimType!=0">
                    <group show_if="AnimType!=6">
                        <checkbox label="Randomize Time" dataBindings="RandomAnimationTime" />
                    </group>
                </group>

                <label>Scrolling speed</label>
                <group horizontal="1" enable_if="AnimType>0">
                    <group horizontal="1" enable_if="AnimType!=6">
                        <label>Emissive</label>
                        <label>U</label>
                        <textbox dataBindings="EmissiveUVSpeed.x" />
                        <label>V</label>
                        <textbox dataBindings="EmissiveUVSpeed.y" />
                    </group>
                </group>

                <label>Number of Frames / Framerate</label>
                <group horizontal="1" enable_if="AnimType==2||AnimType==5||AnimType==6">
                    <label>X</label>
                    <textbox dataBindings="NbFramesX" />
                    <label alignright="1" width="30">Y</label>
                    <textbox dataBindings="NbFramesY" />
                    <label alignright="1" width="30">FPS</label>
                    <textbox dataBindings="Framerate">
                        <dataBindings increment="0.001" />
                    </textbox>
                </group>

                <group show_if="AnimType==2||AnimType==5">
                    <label>Frames Blending</label>
                    <checkbox label="Blend" dataBindings="BlendFrames" />
                    <group enable_if="AnimType==2" >
                        <group horizontal="1" enable_if="BlendFrames" >
                            <label>Delay: </label>
                            <slider dataBindings="BlendDelay">
                                <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                            </slider>
                            <textbox dataBindings="BlendDelay">
                                <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                            </textbox>
                        </group>
                    </group>
                </group>
            </group>

            <group show_if="EmissiveMode==2">
                <checkbox label="Play on load" dataBindings="VideoPlayOnLoad" />
                <group horizontal="1">
                    <label>Share Channel</label>
                    <textbox dataBindings="VideoShareChannel" tooltip="All videos using same Bink file on the same channel will play in sync. 0 = not shared.">
                        <dataBindings increment="1" minvalue="0" maxvalue="100" />
                    </textbox>
                    <group horizontal="1" show_if="VideoShareChannel>0" >
                        <label color="0000FF">      Video will play in sync with other videos using same Bink file on same channel.</label>
                    </group>
                </group>
            </group>

            <group label="Remapping">
                <group horizontal="1">
                    <label alignright="1" width="90">Minimum</label>
                    <label> 0</label>
                    <slider dataBindings="EmissiveTextureRemap.y">
                        <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </slider>
                    <label alignright="1" width="20">1</label>
                    <textbox dataBindings="EmissiveTextureRemap.y">
                        <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </textbox>
                </group>
                <group horizontal="1">
                    <label alignright="1" width="90">Power</label>
                    <label> 0</label>
                    <slider dataBindings="EmissiveTextureRemap.z">
                        <dataBindings increment="0.001" minvalue="0.01" maxvalue="10.0" displayvaluelog2="1" displayvalueaddXX="0.66666666666666666666666666666667" displayvaluemulXX="1" displayvaluedivXX="9.96578428466" />
                    </slider>
                    <label alignright="1" width="20">10</label>
                    <textbox dataBindings="EmissiveTextureRemap.z">
                        <dataBindings increment="0.001" minvalue="0.01" maxvalue="10.0" />
                    </textbox>
                </group>
                <group horizontal="1">
                    <label alignright="1" width="90">Maximum</label>
                    <label> 0</label>
                    <slider dataBindings="EmissiveTextureRemap.x">
                        <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </slider>
                    <label alignright="1" width="20">1</label>
                    <textbox dataBindings="EmissiveTextureRemap.x">
                        <dataBindings increment="0.001" minvalue="0.0" maxvalue="1.0" />
                    </textbox>
                </group>
                <checkbox label="Pre-multiply emissive by emissive alpha" dataBindings="PreMultiplyEmissiveByAlpha" />
            </group>

            <label></label>
            <group label="Luminance" horizontal="1">
                <group horizontal="1">
                    <label>Power (EV)</label>
                    <textbox dataBindings="EmissiveIntensity">
                        <dataBindings minvalue="-100.0f" maxvalue="100.0" />
                    </textbox>
                    <label>Relative power (EV)</label>
                    <textbox dataBindings="EmissiveIntensityOffset">
                        <dataBindings minvalue="-100.0" maxvalue="100.0" />
                    </textbox>
                </group>
            </group>
        </group>
    </ui>
</materialdescriptor>